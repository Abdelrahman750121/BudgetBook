@model BudgetBook.Models.Transaction

@{
    ViewData["Title"] = "Buchung löschen";
}

<h1>Buchung löschen</h1>

<div class="alert alert-warning mt-4">
    Möchtest du diese Buchung wirklich löschen?
</div>

<div class="card p-4 mt-3">

    <dl class="row">

        <dt class="col-sm-3">Betrag</dt>
        <dd class="col-sm-9">
            @Model.Amount.ToString("0.00") €
        </dd>

        <dt class="col-sm-3">Datum</dt>
        <dd class="col-sm-9">
            @Model.BookingDate.ToString("dd.MM.yyyy")
        </dd>

        <dt class="col-sm-3">Typ</dt>
        <dd class="col-sm-9">
            @Model.Type
        </dd>

        <dt class="col-sm-3">Kategorie</dt>
        <dd class="col-sm-9">
            @Model.Category.Name
        </dd>

        <dt class="col-sm-3">Beschreibung</dt>
        <dd class="col-sm-9">
            @Model.Description
        </dd>

    </dl>

</div>

<form asp-action="DeleteConfirmed" method="post" class="mt-3">

    <input type="hidden"
           name="id"
           value="@Model.Id" />

    <button type="submit" class="btn btn-danger">
        Löschen
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Abbrechen
    </a>

</form>